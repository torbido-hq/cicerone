# Cicerone reads its structural configuration from config/cicerone.toml
# (kind of backend, bucket/table names, scheduling, tuning...). This file
# only supplies the secrets that cicerone.toml references via ${...}
# placeholders — see config/cicerone.toml for the full list of options and
# how to switch backends (S3-compatible storage, local disk, or a database).

# Used when [input.options].storage_backend = "s3" in cicerone.toml
INPUT_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
INPUT_S3_ACCESS_KEY_ID=changeme
INPUT_S3_SECRET_ACCESS_KEY=changeme
INPUT_S3_BUCKET=my-recsys-bucket

# Used when [output.options].storage_backend = "s3" in cicerone.toml
OUTPUT_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
OUTPUT_S3_ACCESS_KEY_ID=changeme
OUTPUT_S3_SECRET_ACCESS_KEY=changeme
OUTPUT_S3_BUCKET=my-recsys-bucket

# Used when [input]/[output].kind = "db" in cicerone.toml.
# Opt into local Postgres with: docker compose --profile db up -d postgres
# Databases on first boot: `cicerone` (app/tutorial) and `cicerone_test`
# (pytest — use this for TEST_DATABASE_URL so tests never wipe app data).
# Compose leaves these unset by default — set them when you actually use
# kind = "db" (containers use host `postgres`; host tools use `localhost`):
# INPUT_DATABASE_URL=postgresql+psycopg://cicerone:cicerone@postgres:5432/cicerone
# OUTPUT_DATABASE_URL=postgresql+psycopg://cicerone:cicerone@postgres:5432/cicerone

# Used when [job].mode = "serve" (config/cicerone.serve.toml's [serve].auth_token)
# -- required for the serve API's "Authorization: Bearer <token>" check.
# SERVE_AUTH_TOKEN=changeme

# Used when [job.trigger].enabled = true (cicerone.toml's [job.trigger].auth_token)
# -- required for the retrain webhook's "Authorization: Bearer <token>" check.
# TRIGGER_AUTH_TOKEN=changeme
