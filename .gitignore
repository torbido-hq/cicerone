__pycache__/
*.pyc
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.env

# Compiled by docker/Dockerfile's "frontend" build stage (Tailwind CLI) --
# see src/cicerone/static/tailwind.input.css.
src/cicerone/static/tailwind.css

# package.json/package-lock.json (repo root) are only used by that same
# "frontend" Docker build stage -- Node itself never runs on the host, but
# `npm install` locally (e.g. to regenerate package-lock.json) would create
# this.
node_modules/

# GitHub Pages site build output (Tailwind compile in website/).
website/dist/

# Dashboard Basic Auth credentials (managed via
# `python -m cicerone.manage_dashboard_users`) -- never commit real ones.
config/dashboard_users.toml


# Local virtualenv (never commit)
.venv/

# Optional local-only agent notes. Cloud Agent VMs never see this file
# (clone skips gitignored paths). Do not rely on it for Cloud sessions.
# Cross-session agent policy that Cloud must always see lives in:
#   - CONTRIBUTING.md (Pull requests / Releasing)
#   - .cursor/rules/*.mdc (alwaysApply)
# Non-git alternative: Cursor Customize → Rules → User Rules / Team Rules
# (paste the same content once; it is injected every Agent session).
AGENTS.md

*.egg-info/
