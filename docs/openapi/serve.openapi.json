{
  "components": {
    "headers": {
      "X-Generated-At": {
        "description": "ISO timestamp from the last job-run manifest (mirrors body.generated_at)",
        "schema": {
          "example": "2026-08-04T03:00:00+00:00",
          "type": "string"
        }
      }
    },
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "examples": [
              "ok"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "RecommendationItem": {
        "properties": {
          "item_id": {
            "description": "Catalog item identifier",
            "title": "Item Id",
            "type": "string"
          },
          "rank": {
            "description": "1-based position in the returned list",
            "minimum": 1.0,
            "title": "Rank",
            "type": "integer"
          },
          "score": {
            "description": "Score from the batch job (strategy- or blend-specific)",
            "title": "Score",
            "type": "number"
          },
          "source": {
            "description": "Origin label, e.g. personalized, popular, latest, blended, popular_fallback",
            "examples": [
              "blended"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "rank",
          "score",
          "source"
        ],
        "title": "RecommendationItem",
        "type": "object"
      },
      "RecommendationsResponse": {
        "properties": {
          "fallback": {
            "description": "True when the cold-start list was used because the user had no personal rows",
            "title": "Fallback",
            "type": "boolean"
          },
          "generated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO timestamp from the last job-run manifest (also sent as X-Generated-At)",
            "examples": [
              "2026-08-04T03:00:00+00:00"
            ],
            "title": "Generated At"
          },
          "items": {
            "description": "Ordered top-K recommendations",
            "items": {
              "$ref": "#/components/schemas/RecommendationItem"
            },
            "title": "Items",
            "type": "array"
          },
          "user_id": {
            "description": "Echo of the requested user_id path parameter",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "fallback",
          "items"
        ],
        "title": "RecommendationsResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Read-only HTTP API over **precomputed** recommendations written by the batch job.\n\nThere is no live inference in the request path: `GET /recommendations/{user_id}`\nlooks up rows already stored in the configured output (dataset parquet or DB).\n\nInteractive docs: `/docs` (Swagger UI) and `/redoc`. Machine-readable schema: `/openapi.json`.\nA checked-in copy lives at `docs/openapi/serve.openapi.json` (regenerate with\n`python -m cicerone.export_serve_openapi`).",
    "title": "Cicerone Serve API",
    "version": "0.4.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/recommendations/{user_id}": {
      "get": {
        "operationId": "get_recommendations_recommendations__user_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "title": "User Id",
              "type": "string"
            }
          },
          {
            "description": "Top-K rows to return",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Top-K rows to return",
              "title": "Limit"
            }
          },
          {
            "description": "Alias for limit (back-compat)",
            "in": "query",
            "name": "k",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Alias for limit (back-compat)",
              "title": "K"
            }
          },
          {
            "description": "Keep only items whose configured category column matches this value",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Keep only items whose configured category column matches this value",
              "title": "Category"
            }
          },
          {
            "description": "Re-apply item_availability_filters against the items snapshot",
            "in": "query",
            "name": "exclude_unavailable",
            "required": false,
            "schema": {
              "default": true,
              "description": "Re-apply item_availability_filters against the items snapshot",
              "title": "Exclude Unavailable",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationsResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Generated-At": {
                "$ref": "#/components/headers/X-Generated-At"
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Conflicting limit and k"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "No rows and no cold-start fallback"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Precomputed top-K recommendations for a user",
        "tags": [
          "recommendations"
        ]
      }
    }
  }
}
