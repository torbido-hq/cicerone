# Canonical local/CI Postgres defaults for Cicerone.
# Consumed by docker-compose.yml and docker-compose.ci.yml (env_file).
# Docs (CONTRIBUTING.md) point here — avoid re-stating these values elsewhere.
#
# App / tutorial database (POSTGRES_DB) vs pytest database (POSTGRES_TEST_DB).
POSTGRES_USER=cicerone
POSTGRES_PASSWORD=cicerone
POSTGRES_DB=cicerone
POSTGRES_TEST_DB=cicerone_test
# Host port published by compose postgres (bound to 127.0.0.1 only).
POSTGRES_HOST_PORT=5432
