# Canonical local/CI Postgres defaults for Cicerone.
# Consumed by docker-compose.yml and docker-compose.ci.yml (env_file), and
# by tests/postgres_defaults.py / docker/postgres/test-database-url.sh when
# assembling TEST_DATABASE_URL. Docs (CONTRIBUTING.md) point here — avoid
# re-stating these values or hand-building the URL elsewhere.
#
# App / tutorial database (POSTGRES_DB) vs pytest database (POSTGRES_TEST_DB).
POSTGRES_USER=cicerone
POSTGRES_PASSWORD=cicerone
POSTGRES_DB=cicerone
POSTGRES_TEST_DB=cicerone_test
# Container listen port (in-network URLs: host postgres / db-test).
POSTGRES_PORT=5432
# Host-published map port only (URLs with localhost / 127.0.0.1).
# Compose binds 127.0.0.1:${POSTGRES_HOST_PORT}:5432.
POSTGRES_HOST_PORT=5432
